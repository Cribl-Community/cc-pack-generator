# Cribl Cloud OAuth2 client credentials
# Create at: Cribl Cloud → Settings → API Credentials → Add Credentials (Client Credentials)
# Required scopes: full access to the worker group you'll deploy packs to
#
# CRIBL_ORG is the full base URL of your Cribl Cloud org (what you see in the browser).
# Pattern: https://main-<orgname>-<hash>.cribl.cloud
# Example: https://main-yourorg-hash.cribl.cloud
CRIBL_ORG=https://main-yourorg-yourhash.cribl.cloud
CRIBL_CLIENT_ID=your-client-id
CRIBL_CLIENT_SECRET=your-client-secret

# --- Standalone dev API access (optional, server-only) ---
# Non-loopback clients must send this exact value in X-Packgen-Gate. Never
# prefix this with VITE_: the gate must remain available to the server only.
PACKGEN_DEV_GATE=

# --- Shared golden GitHub access (optional, server-only) ---
# READING the shared goldens needs NO credential: the pool is a public repository
# and every install reads it over raw.githubusercontent.com. Set this only to
# PUBLISH, with Contents:Read+Write on the goldens repo. Never prefix it with
# VITE_: Vite variables are compiled into the browser bundle.
GOLDEN_READ_TOKEN=

# --- User identity (for score logging) ---
# Email address shown in score reports logged to the pack_generator_app_scores dataset.
CRIBL_USER_EMAIL=you@yourcompany.com

# --- Lake score-dataset ingest (optional) ---
# Per-pipeline deploy scores are logged to a Cribl Lake dataset via a "direct
# access" NDJSON endpoint. Create the dataset + a direct-access token in Cribl
# Lake, then set the full ingest URL + token here (or configure them in the app's
# Lake/Quality settings, which override these). Leave blank to disable logging.
# LAKE_URL=https://direct-access-<id>.main-<org>.cribl.cloud:10080/datasets/pack_generator_app_scores
# LAKE_TOKEN=your-direct-access-token

# --- AI backend (optional) ---
# The app's AI features (sample generation, AI parse/mapping, scoring,
# sourcetype detection) call an Anthropic-Messages/Bedrock-style endpoint at
# `${AI_BASE}/model/${AI_MODEL}/invoke`.
#
# Defaults (leave unset) target Cribl's internal Aperture proxy — only reachable
# on the Cribl corporate network with Tailscale up. The GOLDEN (deterministic)
# path works with NO AI regardless; these vars only affect AI-assisted features.
#
# To use your OWN endpoint off the Cribl network, set both:
#   AI_BASE=https://bedrock-runtime.us-east-1.amazonaws.com   (or a compatible proxy)
#   AI_MODEL=us.anthropic.claude-sonnet-4-6
# AI_BASE=
# AI_MODEL=
